# Relayer Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# TON Network Configuration ('testnet' or 'mainnet')
TON_NETWORK=testnet
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# Optional Toncenter API key for higher rate limits
TON_API_KEY=

# Relayer Wallet Settings (Sponsors gas for users)
# 24-word mnemonic seed phrase of the relayer hot wallet
# KEEP THIS SECRET! Never commit this file or expose in client code.
RELAYER_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# Gas Sponsorship Limits
MAX_GAS_PER_TX_TON=0.05
MIN_RELAYER_BALANCE_TON=0.5
DAILY_TREASURY_LIMIT_TON=10.0

# Anti-Abuse & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
MAX_PENDING_PER_WALLET=3
MAX_PAYLOAD_SIZE_BYTES=4096

# App Attribution & Access Control
REQUIRE_API_KEY=false
RELAYER_API_KEYS=app1_secret_key,app2_secret_key

# Economic Fee Mode ('sponsored' or 'jetton_fee')
FEE_MODE=sponsored
FEE_COLLECTOR_ADDRESS=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAM9c

# Confirmation Polling
WAIT_FOR_CONFIRMATION=false
CONFIRMATION_TIMEOUT_MS=30000
