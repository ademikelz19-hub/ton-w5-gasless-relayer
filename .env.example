# Relayer Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# TON Network Configuration ('testnet' or 'mainnet')
TON_NETWORK=testnet
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# Optional Toncenter API key for higher rate limits
TON_API_KEY=

# Relayer Wallet Settings (Sponsors gas for users)
# 24-word mnemonic seed phrase of the relayer hot wallet
# KEEP THIS SECRET! Never commit this file or expose in client code.
RELAYER_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# Gas Sponsorship Limits
# NOTE on sizing this: a single jetton-transfer action needs ~0.06 TON (see
# JETTON_ACTION_BASE_GAS_TON in src/engine/w5-spec.ts for why), so the default here (0.08)
# has some headroom for one action. If you enable FEE_MODE=jetton_fee below, the signed
# payload will contain a SECOND jetton-value-bearing action (the fee), so raise this to at
# least ~0.15 TON — the SDK computes the actual required amount per request
# (W5PayloadBuilder.estimateRequiredGasTon) and the server validates it against this
# ceiling; requests that need more than you've configured here are rejected with
# GAS_LIMIT_EXCEEDED rather than silently under-funded.
MAX_GAS_PER_TX_TON=0.08
MIN_RELAYER_BALANCE_TON=0.5
DAILY_TREASURY_LIMIT_TON=10.0

# Anti-Abuse & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
MAX_PENDING_PER_WALLET=3
MAX_PAYLOAD_SIZE_BYTES=4096

# App Attribution & Access Control
REQUIRE_API_KEY=false
RELAYER_API_KEYS=app1_secret_key,app2_secret_key

# Economic Fee Mode ('sponsored' or 'jetton_fee')
# jetton_fee is ENFORCED server-side: a signed payload that doesn't include a
# jetton-transfer action sending at least MIN_JETTON_FEE_UNITS to FEE_COLLECTOR_ADDRESS is
# rejected with MISSING_REQUIRED_FEE. FEE_COLLECTOR_ADDRESS is required when this is set
# to jetton_fee (the server refuses to start otherwise).
FEE_MODE=sponsored
FEE_COLLECTOR_ADDRESS=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAM9c
MIN_JETTON_FEE_UNITS=50000

# Confirmation Polling
WAIT_FOR_CONFIRMATION=false
CONFIRMATION_TIMEOUT_MS=30000

# Distributed state (REQUIRED for any deployment running more than one relayer instance).
# Without this, ReplayGuard's nonce locks and TreasuryGuard's daily spend cap are
# process-local only and will NOT be shared across replicas behind a load balancer.
REDIS_URL=
